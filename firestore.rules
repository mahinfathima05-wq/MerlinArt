rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    match /enquiries/{enquiryId} {
      allow create: if request.resource.data.keys().hasOnly([
          'name',
          'phone',
          'email',
          'service',
          'message',
          'smsConsent',
          'status',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'name',
          'phone',
          'email',
          'service',
          'message',
          'smsConsent',
          'status',
          'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 20
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.service in [
          'Creative Artist Painting',
          'Play School Cartoon Painting',
          'Residential Painting',
          'Commercial Painting',
          'Industrial Painting',
          'Interior Texture Painting',
          'Optic Fiber Ceiling Galaxy Lighting'
        ]
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000
        && request.resource.data.smsConsent is bool
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;

      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'phone',
          'email',
          'service',
          'message',
          'smsConsent',
          'status',
          'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 20
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.service in [
          'Creative Artist Painting',
          'Play School Cartoon Painting',
          'Residential Painting',
          'Commercial Painting',
          'Industrial Painting',
          'Interior Texture Painting',
          'Optic Fiber Ceiling Galaxy Lighting'
        ]
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000
        && request.resource.data.smsConsent is bool
        && request.resource.data.status in ['new', 'in-progress', 'completed']
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /gallery/{imageId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /galleryMeta/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read, write: if false;
    }
  }
}
